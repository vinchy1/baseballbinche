---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Quote from '../components/Quote.astro';
import { timeline, values, press } from '../data/club';
import { committee, coaches, trustedPersons } from '../data/people';
import { site } from '../data/site';
import logo from '../assets/logo-guardians.png';
import heroImg from '../assets/images/hero-equipe-celebration.jpg';
import storyImg from '../assets/images/intro-jeunes-entrainement.jpg';
import quoteBg from '../assets/images/gallery-balles-sol.jpg';

const valueIcons = ['lucide:users', 'lucide:heart-handshake', 'lucide:handshake'];
---

<BaseLayout title="Le club" description="L'histoire des Guardians Binche depuis 2008, nos valeurs, le comité et le staff du club de baseball de Binche.">
  <PageHero
    eyebrow="Le club"
    title="Les Guardians,"
    script="une famille"
    intro="D'une campagne d'affichage en 2008 à sept équipes aujourd'hui : découvrez l'épopée du baseball à Binche."
    image={heroImg}
    imageAlt="Joueurs de baseball qui célèbrent ensemble"
  />

  <!-- Histoire -->
  <section class="section" id="histoire">
    <div class="container story">
      <div class="story-intro" data-reveal>
        <p class="eyebrow eyebrow--left">Notre histoire</p>
        <h2>De 2 membres <span class="script">à plus de 60</span></h2>
        <p class="lead">
          Le club de baseball de Binche est né en 2008 sous l'impulsion de Sébastien Murer. Notre ambition n'a pas changé depuis : partager la passion du baseball dans la
          convivialité.
        </p>
        <div class="frame story-img">
          <Image src={storyImg} alt="Jeunes joueurs à l'entraînement" widths={[500, 900]} sizes="(min-width: 960px) 40vw, 100vw" />
        </div>
      </div>
      <ol class="timeline">
        {
          timeline.map((step, i) => (
            <li data-reveal data-reveal-delay={i * 60}>
              <span class="years">{step.years}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Valeurs -->
  <section class="section section--dark" id="valeurs">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Nos valeurs</p>
        <h2>Ce qui <span class="script">nous anime</span></h2>
      </div>
      <div class="values">
        {
          values.map((v, i) => (
            <article data-reveal data-reveal-delay={i * 120}>
              <Icon name={valueIcons[i]} aria-hidden="true" />
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Logo -->
  <section class="section section--sand" id="logo">
    <div class="container logo-grid">
      <div class="logo-visual" data-reveal="fade">
        <Image src={logo} alt="Logo des Guardians Binche : balle de baseball coiffée d'un casque à panache rouge" width={420} height={494} />
      </div>
      <div data-reveal>
        <p class="eyebrow eyebrow--left">Notre emblème</p>
        <h2>Les gardiens <span class="script">du terrain</span></h2>
        <p class="lead">
          Une balle de baseball coiffée d'un casque à panache rouge, une batte et le nom du club en lettres manuscrites : le logo des Guardians dit tout de notre
          caractère, fier et chaleureux.
        </p>
        <p>Le rouge, couleur du club, se retrouve sur nos tenues et dans chaque détail de notre identité.</p>
      </div>
    </div>
  </section>

  <!-- Organigramme -->
  <section class="section" id="organigramme">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Organigramme</p>
        <h2>Les bénévoles <span class="script">du club</span></h2>
        <p>Une ASBL qui vit grâce à l'énergie de ses bénévoles, sur le terrain comme en coulisses.</p>
      </div>

      <h3 class="group-title" data-reveal>Comité</h3>
      <ul class="people">
        {
          committee.map((p) => (
            <li data-reveal>
              <span class="initials" aria-hidden="true">{p.name.split(' ').map((n) => n[0]).slice(0, 2).join('')}</span>
              <span class="p-name">{p.name}</span>
              <span class="p-role">{p.role}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="group-title" data-reveal>Coaches</h3>
      <ul class="people">
        {
          coaches.map((p) => (
            <li data-reveal>
              <span class="initials" aria-hidden="true">{p.name.split(' ').map((n) => n[0]).slice(0, 2).join('')}</span>
              <span class="p-name">{p.name}</span>
              <span class="p-role">{p.role}</span>
            </li>
          ))
        }
      </ul>

      <div class="trust" data-reveal>
        <Icon name="lucide:shield-check" aria-hidden="true" />
        <div>
          <h3>Personnes de confiance</h3>
          <p>Un souci, une question délicate ? Ces membres sont à l'écoute, en toute discrétion : {trustedPersons.join(', ')}.</p>
        </div>
      </div>
    </div>
  </section>

  <Quote image={quoteBg} cite="Les Guardians Binche">
    Au baseball, <em>chaque joueur</em> est essentiel
  </Quote>

  <!-- Presse -->
  <section class="section" id="presse">
    <div class="container container--narrow">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Revue de presse</p>
        <h2>On parle <span class="script">de nous</span></h2>
      </div>
      <ul class="press">
        {
          press.map((item) => (
            <li data-reveal>
              <time>{item.date}</time>
              <span class="press-title">{item.title}</span>
              <span class="press-source">{item.source}</span>
            </li>
          ))
        }
      </ul>
      <p class="press-more" data-reveal>
        <a href={site.kalisport.press} class="link-arrow" target="_blank" rel="noopener">Lire les articles <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a>
      </p>
    </div>
  </section>

  <section class="section section--red join">
    <div class="container join-inner" data-reveal>
      <h2>Envie de rejoindre <span class="script">l'aventure ?</span></h2>
      <p class="lead">Découvrez nos disciplines lors de 3 entraînements d'essai gratuits.</p>
      <div class="btn-row">
        <a href="/rejoindre#essai" class="btn btn--white">Je réserve mon essai</a>
        <a href="/contact" class="btn btn--light">Nous contacter</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .story { display: grid; gap: clamp(3rem, 6vw, 6rem); }
  @media (min-width: 960px) { .story { grid-template-columns: 0.9fr 1fr; } .story-intro { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; } }
  .story-img { aspect-ratio: 16 / 11; margin-top: 2rem; }

  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 0.45rem; top: 0.5rem; bottom: 0.5rem; width: 1px; background: var(--line); }
  .timeline li { position: relative; padding: 0 0 2.75rem 2.75rem; }
  .timeline li:last-child { padding-bottom: 0; }
  .timeline li::before { content: ''; position: absolute; left: 0; top: 0.35rem; width: 0.95rem; height: 0.95rem; border-radius: 50%; background: var(--paper); border: 3px solid var(--red); }
  .years { font-family: var(--font-script); font-size: 1.9rem; color: var(--red); line-height: 1; }
  .timeline h3 { margin: 0.5rem 0 0.6rem; }
  .timeline p { color: var(--muted); margin: 0; }

  .values { display: grid; gap: 2.5rem; }
  @media (min-width: 860px) { .values { grid-template-columns: repeat(3, 1fr); } }
  .values article { border-top: 1px solid rgba(255, 255, 255, 0.18); padding-top: 2rem; }
  .values svg { width: 2.5rem; height: 2.5rem; color: var(--red); margin-bottom: 1.25rem; }
  .values p { color: #b9b2a9; margin: 0; }

  .logo-grid { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  @media (min-width: 860px) { .logo-grid { grid-template-columns: 0.8fr 1fr; } }
  .logo-visual { display: grid; place-items: center; background: var(--paper); padding: clamp(2rem, 6vw, 4rem); }
  .logo-visual img { width: min(100%, 320px); height: auto; }

  .group-title { font-family: var(--font-accent); font-size: 1.4rem; letter-spacing: 0.08em; color: var(--red-deep); margin: 3rem 0 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--line); }
  .people { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .people li { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 1rem; align-items: center; background: var(--white); padding: 1rem 1.25rem; }
  .initials { grid-row: span 2; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--sand); color: var(--red-deep); font-family: var(--font-display); font-weight: 400; font-size: 0.95rem; }
  .p-name { font-weight: 600; color: var(--black); line-height: 1.3; }
  .p-role { font-size: 0.88rem; color: var(--muted); line-height: 1.3; }

  .trust { display: flex; gap: 1.25rem; align-items: flex-start; margin-top: 3rem; padding: 1.75rem; border: 1px solid var(--line); background: var(--white); }
  .trust svg { width: 2rem; height: 2rem; color: var(--red); flex-shrink: 0; }
  .trust h3 { margin-bottom: 0.4rem; font-size: 1rem; }
  .trust p { margin: 0; color: var(--muted); }

  .press { list-style: none; margin: 0; padding: 0; }
  .press li { display: grid; gap: 0.2rem 2rem; padding-block: 1.25rem; border-bottom: 1px solid var(--line); }
  @media (min-width: 700px) { .press li { grid-template-columns: 10rem 1fr auto; align-items: baseline; } }
  .press time { font-size: 0.85rem; color: var(--red-deep); font-weight: 600; letter-spacing: 0.04em; }
  .press-title { font-weight: 600; color: var(--black); }
  .press-source { font-size: 0.85rem; color: var(--muted); font-style: italic; }
  .press-more { text-align: center; margin-top: 2.5rem; }

  .join-inner { text-align: center; }
  .join .script { color: var(--white); }
  .join .lead { color: rgba(255, 255, 255, 0.92); }
  .join .btn-row { justify-content: center; margin-top: 2rem; }
</style>
