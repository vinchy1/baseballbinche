---
import { Icon } from 'astro-icon/components';
import { venues } from '../data/practical';
---

<ul class="venues">
  {
    venues.map((v, i) => (
      <li data-reveal data-reveal-delay={i * 90}>
        <Icon name="lucide:map-pin" class="pin" aria-hidden="true" />
        <p class="usage">{v.usage}</p>
        <h3>{v.name}</h3>
        <p class="address">{v.address}<br />{v.city}</p>
        <a class="link-arrow" href={v.map} target="_blank" rel="noopener">
          Itinéraire <Icon name="lucide:arrow-up-right" aria-hidden="true" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .venues { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .venues { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .venues { grid-template-columns: repeat(4, 1fr); } }
  li { background: var(--paper); padding: 2rem 1.75rem; display: flex; flex-direction: column; }
  .pin { width: 1.75rem; height: 1.75rem; color: var(--red); margin-bottom: 1rem; }
  .usage { font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.4rem; }
  h3 { font-size: 1.05rem; margin-bottom: 0.6rem; }
  .address { flex: 1; }
  .link-arrow { align-self: flex-start; }
</style>
