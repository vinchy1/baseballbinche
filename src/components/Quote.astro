---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  cite?: string;
}
const { image, cite } = Astro.props;
---

<section class="quote on-image">
  <Image src={image} alt="" widths={[768, 1280, 1920]} sizes="100vw" quality={55} class="bg" />
  <div class="shade" aria-hidden="true"></div>
  <figure class="container container--narrow" data-reveal>
    <span class="mark" aria-hidden="true">“</span>
    <blockquote><slot /></blockquote>
    {cite && <figcaption>{cite}</figcaption>}
  </figure>
</section>

<style>
  .quote { position: relative; overflow: hidden; background: var(--red-dark); color: var(--white); text-align: center; padding-block: clamp(6rem, 14vw, 11rem); }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1); }
  .shade { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(196, 18, 26, 0.93), rgba(20, 20, 20, 0.88)); }
  figure { position: relative; margin-inline: auto; }
  .mark { display: block; font-family: var(--font-display); font-size: 7rem; line-height: 0.5; height: 3.25rem; opacity: 0.55; }
  blockquote { margin: 0; font-family: var(--font-display); font-size: clamp(1.5rem, 1rem + 2.2vw, 2.6rem); line-height: 1.25; letter-spacing: 0.01em; text-wrap: balance; }
  blockquote :global(em) { font-family: var(--font-script); font-style: normal; font-size: 1.3em; letter-spacing: 0; }
  figcaption { margin-top: 2rem; font-family: var(--font-accent); font-size: 1.15rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.85; }
  figcaption::before { content: ''; display: block; width: 3rem; height: 1px; background: currentColor; margin: 0 auto 1.25rem; }
</style>
