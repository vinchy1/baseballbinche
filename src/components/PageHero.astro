---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  script?: string;
  intro?: string;
  image: ImageMetadata;
  imageAlt: string;
  position?: string;
}
const { eyebrow, title, script, intro, image, imageAlt, position = 'center' } = Astro.props;
---

<section class="page-hero on-image">
  <Image src={image} alt={imageAlt} widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${position}`} />
  <div class="shade" aria-hidden="true"></div>
  <div class="container content">
    <p class="eyebrow">{eyebrow}</p>
    <h1>
      {title}
      {script && <span class="script">{script}</span>}
    </h1>
    {intro && <p class="intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative; min-height: clamp(26rem, 68svh, 40rem); display: grid; align-items: end;
    color: var(--white); background: var(--black); overflow: hidden;
  }
  .page-hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: settle 2.2s var(--ease) both; }
  @keyframes settle { from { transform: scale(1.06); } to { transform: scale(1); } }
  .shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(10, 10, 10, 0.82) 0%, rgba(10, 10, 10, 0.35) 55%, rgba(10, 10, 10, 0.45) 100%); }
  .content { position: relative; padding-top: calc(var(--header-h) + 3rem); padding-bottom: clamp(3rem, 7vw, 5rem); }
  h1 { color: var(--white); max-width: 18ch; margin-bottom: 1rem; }
  h1 .script { color: var(--white); font-size: 1.1em; }
  h1 .script::after { content: ''; display: block; width: 4.5rem; height: 4px; background: var(--red); margin-top: 0.9rem; }
  .intro { max-width: 40rem; font-size: 1.15rem; color: rgba(255, 255, 255, 0.9); margin: 0; }
</style>
