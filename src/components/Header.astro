---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logo from '../assets/logo-guardians.png';
import { nav, site } from '../data/site';

interface Props {
  overlay?: boolean;
}
const { overlay = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href !== '/' && path.startsWith(href);
const isExternal = (href: string) => href.startsWith('http');
---

<header class="site-header" data-header data-overlay={overlay ? 'true' : 'false'}>
  <div class="bar">
    <a href="/" class="brand" aria-label="Guardians Binche — accueil">
      <Image src={logo} alt="" width={120} height={141} class="brand-logo" loading="eager" />
      <span class="brand-text">
        <span class="brand-name">Guardians</span>
        <span class="brand-sub">Baseball Club Binche</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navigation principale">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li class:list={['nav-item', { 'has-children': item.children }]}>
              <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
                {item.children && <Icon name="lucide:chevron-down" class="chev" aria-hidden="true" />}
              </a>
              {item.children && (
                <ul class="dropdown">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} {...(isExternal(child.href) ? { target: '_blank', rel: 'noopener' } : {})}>
                        {child.label}
                        {isExternal(child.href) && <Icon name="lucide:arrow-up-right" aria-hidden="true" />}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a href={site.kalisport.login} class="login" target="_blank" rel="noopener">
        <Icon name="lucide:circle-user-round" aria-hidden="true" />
        <span>Connexion</span>
      </a>
      <a href="/rejoindre#essai" class="btn cta">Essai gratuit</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <span class="sr-only">Ouvrir le menu</span>
        <span class="burger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Navigation mobile">
      <ul>
        <li><a href="/" class="m-link">Accueil</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="m-link">{item.label}</a>
              {item.children && (
                <ul class="m-sub">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} {...(isExternal(child.href) ? { target: '_blank', rel: 'noopener' } : {})}>{child.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <div class="m-actions">
        <a href="/rejoindre#essai" class="btn">3 essais gratuits</a>
        <a href={site.kalisport.login} class="btn btn--light" target="_blank" rel="noopener">Espace membre</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 100;
    color: var(--black); background: rgba(250, 247, 242, 0.97);
    box-shadow: 0 1px 0 var(--line);
    transition: background 0.4s var(--ease), box-shadow 0.4s var(--ease), color 0.4s var(--ease);
  }
  .site-header[data-overlay='true']:not(.is-scrolled):not(.menu-open) {
    color: var(--white); background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
    box-shadow: none;
  }
  .bar {
    display: flex; align-items: center; gap: 1.5rem;
    height: var(--header-h); max-width: 1440px; margin-inline: auto; padding-inline: var(--gutter);
  }

  .brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; flex-shrink: 0; }
  .brand-logo { width: auto; height: 62px; transform-origin: left center; transition: transform 0.4s var(--ease); filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.18)); }
  .is-scrolled .brand-logo { transform: scale(0.84); }
  .brand-text { display: grid; line-height: 1; }
  .brand-name { font-family: var(--font-script); font-size: 1.85rem; color: var(--red); line-height: 0.9; }
  .site-header[data-overlay='true']:not(.is-scrolled):not(.menu-open) .brand-name { color: var(--white); }
  .brand-sub { font-family: var(--font-accent); font-size: 0.85rem; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; margin-top: 0.3rem; }

  .nav { margin-inline: auto; }
  .nav-list { display: flex; gap: clamp(0.5rem, 1.6vw, 1.75rem); list-style: none; margin: 0; padding: 0; }
  .nav-item { position: relative; }
  .nav-link {
    display: flex; align-items: center; gap: 0.3rem; height: var(--header-h);
    font-family: var(--font-accent); font-size: 1.2rem; font-weight: 400; letter-spacing: 0.06em;
    text-transform: uppercase; text-decoration: none; position: relative;
  }
  .nav-link::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: calc(50% - 1.1rem); height: 2px;
    background: var(--red); transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--ease);
  }
  .nav-item:hover .nav-link::after, .nav-link[aria-current='page']::after, .nav-item:focus-within .nav-link::after { transform: scaleX(1); }
  .chev { width: 0.9rem; height: 0.9rem; transition: transform 0.3s var(--ease); }
  .nav-item:hover .chev { transform: rotate(180deg); }

  .dropdown {
    position: absolute; top: calc(100% - 0.75rem); left: -1.25rem; min-width: 15rem;
    list-style: none; margin: 0; padding: 0.75rem 0;
    background: var(--white); color: var(--ink); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.14);
    border-top: 3px solid var(--red);
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0.25s;
  }
  .nav-item:hover .dropdown, .nav-item:focus-within .dropdown { opacity: 1; visibility: visible; transform: none; }
  .dropdown a {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.55rem 1.25rem; font-size: 0.95rem; text-decoration: none; white-space: nowrap;
    transition: color 0.2s, background 0.2s;
  }
  .dropdown a:hover { color: var(--red-deep); background: var(--paper); }
  .dropdown svg { width: 0.9rem; height: 0.9rem; }

  .actions { display: flex; align-items: center; gap: 1.1rem; flex-shrink: 0; }
  .login { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; font-weight: 600; text-decoration: none; opacity: 0.9; }
  .login:hover { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }
  .login svg { width: 1.3rem; height: 1.3rem; }
  .cta { min-height: 2.8rem; padding: 0.6rem 1.3rem; font-size: 1.05rem; }

  .burger { display: none; width: 2.75rem; height: 2.75rem; background: none; border: 0; padding: 0; cursor: pointer; color: inherit; }
  .burger-lines { display: grid; gap: 6px; width: 26px; margin: auto; }
  .burger-lines span { height: 2px; background: currentColor; transition: transform 0.35s var(--ease), opacity 0.2s; }
  .menu-open .burger-lines span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .menu-open .burger-lines span:nth-child(2) { opacity: 0; }
  .menu-open .burger-lines span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  .mobile-menu {
    position: fixed; inset: var(--header-h) 0 0; overflow-y: auto;
    background: var(--black); color: var(--white); padding: 2rem var(--gutter) 3rem;
  }
  .mobile-menu ul { list-style: none; margin: 0; padding: 0; }
  .mobile-menu > nav > ul > li { border-bottom: 1px solid rgba(255, 255, 255, 0.12); padding-block: 0.9rem; }
  .m-link { font-family: var(--font-display); font-size: 1.35rem; font-weight: 400; letter-spacing: 0.02em; text-transform: uppercase; text-decoration: none; }
  .m-sub { display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; margin-top: 0.5rem !important; }
  .m-sub a { font-size: 0.95rem; color: #b9b2a9; text-decoration: none; }
  .m-sub a:hover { color: var(--white); }
  .m-actions { display: grid; gap: 0.75rem; margin-top: 2rem; }

  @media (max-width: 1180px) {
    .brand-text { display: none; }
  }
  @media (max-width: 1020px) {
    .nav, .login { display: none; }
    .burger { display: block; }
    .actions { margin-left: auto; }
  }
  @media (max-width: 480px) {
    .cta { display: none; }
    .brand-text { display: grid; }
    .brand-logo { height: 52px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (header && burger && menu) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.querySelector('.sr-only')!.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
      menu.hidden = !open;
      header.classList.toggle('menu-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        burger.focus();
      }
    });
  }
</script>
